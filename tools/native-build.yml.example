name: Private native desktop builds
on: workflow_dispatch
permissions:
  contents: read
jobs:
  native:
    strategy:
      fail-fast: false
      matrix:
        include:
          - runner: ubuntu-22.04
            os: linux
            target: x86_64-unknown-linux-gnu
          - runner: windows-latest
            os: windows
            target: x86_64-pc-windows-msvc
          - runner: macos-14
            os: macos
            target: aarch64-apple-darwin
          - runner: macos-15-intel
            os: macos
            target: x86_64-apple-darwin
    runs-on: ${{ matrix.runner }}
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
        with:
          targets: ${{ matrix.target }}
      - name: Linux libraries
        if: matrix.os == 'linux'
        run: sudo apt-get update && sudo apt-get install -y libasound2-dev libx11-dev libxi-dev libgl1-mesa-dev xvfb
      - name: Verify recovered rules
        run: cargo test --locked --target ${{ matrix.target }}
      - name: Build native release
        run: cargo build --locked --release --target ${{ matrix.target }}
      - name: Check rendered core loop on Linux
        if: matrix.os == 'linux'
        run: xvfb-run -a target/${{ matrix.target }}/release/brick-breaker --self-test self-test.json
      - name: Package Windows
        if: matrix.os == 'windows'
        run: python tools/package.py --os windows --arch ${{ matrix.target }} --binary target/${{ matrix.target }}/release/brick-breaker.exe
      - name: Package Linux and Mac
        if: matrix.os != 'windows'
        run: python3 tools/package.py --os ${{ matrix.os }} --arch ${{ matrix.target }} --binary target/${{ matrix.target }}/release/brick-breaker
      - uses: actions/upload-artifact@v4
        with:
          name: private-${{ matrix.target }}
          path: dist/*.*
          retention-days: 1
